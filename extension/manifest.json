{
  "manifest_version": 3,
  "name": "Smart Subtitles",
  "version": "1.3.2",
  "description": "Bilingual subtitles for Hulu and Disney+. Browser translation, your ChatGPT plan, or your own API. Runs entirely in Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "127",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
  },
  "permissions": [
    "storage",
    "scripting",
    "offscreen",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.hulu.com/*",
    "https://hulu.com/*",
    "https://*.disneyplus.com/*",
    "https://disneyplus.com/*",
    "http://127.0.0.1/*",
    "https://*.dssott.com/*",
    "https://*.dssedge.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Subtitles",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hulu.com/*",
        "https://hulu.com/*",
        "https://*.disneyplus.com/*",
        "https://disneyplus.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "sites.js",
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.hulu.com/*",
        "https://hulu.com/*",
        "https://*.disneyplus.com/*",
        "https://disneyplus.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "sites.js",
        "core.js",
        "ttml.js",
        "site.js",
        "players/hulu.js",
        "players/disney.js",
        "tracks.js",
        "builtin.js",
        "session.js",
        "overlay.js",
        "probe.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "auth-callback.html"
      ],
      "matches": [
        "https://auth.openai.com/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
